{
	"name": "@xl0/lovely-notebook-mcp",
	"version": "0.1.0",
	"description": "MCP server: per-cell Jupyter notebook tools for reading and editing .ipynb files",
	"license": "MIT",
	"type": "module",
	"author": {
		"name": "Alexey Zaytsev",
		"url": "https://github.com/xl0",
		"email": "alexey.zaytsev@gmail.com"
	},
	"homepage": "https://github.com/xl0/pi-lovely-notebook/tree/master/packages/mcp#readme",
	"bugs": {
		"url": "https://github.com/xl0/pi-lovely-notebook/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xl0/pi-lovely-notebook.git",
		"directory": "packages/mcp"
	},
	"keywords": [
		"mcp",
		"mcp-server",
		"model context protocol",
		"claude code",
		"jupyter",
		"jupyter notebook",
		"notebook",
		"ipynb"
	],
	"files": [
		"src/",
		"dist/",
		"README.md",
		"LICENSE"
	],
	"bin": {
		"lovely-notebook-mcp": "./dist/bin.js"
	},
	"scripts": {
		"build": "rm -rf dist && bun build src/bin.ts --outdir dist --target node --format esm --external @modelcontextprotocol/sdk --external typebox --external @xl0/lovely-notebook",
		"release": "bun run build && bun publish --access public"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.16.0",
		"@xl0/lovely-notebook": "^0.1.0",
		"typebox": "1.1.38"
	},
	"publishConfig": {
		"access": "public"
	}
}
